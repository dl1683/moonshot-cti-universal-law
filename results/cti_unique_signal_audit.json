  "answer_so_far": {
    "verdict": "kappa_has_unique_within_dataset_signal_but_dataset_extrapolation_and_rank_baseline_are_unproven",
    "strongest_positive": "Under leave-one-model-out, dataset+kappa_nearest reaches R2=0.950 versus dataset-only R2=0.909; adding layer_rank+kappa_nearest reaches R2=0.952 versus dataset+layer R2=0.930.",
    "strongest_negative": "Leave-one-dataset-out remains weak: the best tested LODO model is dataset_plus_model_plus_kappa_min at R2=0.040, while logK+layer+kappa_nearest is R2=-4.701. The source rows do not contain same-row effective_rank/effective_dimension/RankMe metrics, so this artifact cannot prove kappa_nearest beats generic rank geometry.",
    "what_this_proves": [
      "The core artifact is not only a dataset-intercept table: kappa_nearest adds residual signal after dataset and layer controls.",
      "The signal survives held-out model evaluation within the existing dataset set.",
      "Model/layer controls do not absorb all kappa_nearest signal."
    ],
    "what_this_does_not_prove": [
      "It does not prove dataset extrapolation from log(K-1) alone.",
      "It does not by itself prove canonical kappa_nearest beats same-row effective rank or effective dimension.",
      "It does not identify whether kappa_min or mean kappa_nearest is the more fundamental bottleneck variable."
    ],
    "next_required_tests": [
      "Recompute effective_rank, effective_dimension, RankMe, dist_ratio, Fisher, and kappa_nearest on the same canonical 192 rows.",
      "Add multiple datasets sharing the same K so dataset difficulty and log(K-1) are no longer collinear.",
      "Run a strict held-out-dataset audit with a dataset-calibration protocol declared before fitting.",
      "Compare mean kappa_nearest against kappa_min as a bottleneck law candidate."
    ]
